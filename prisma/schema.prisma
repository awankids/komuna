datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

model User {
  id           String @id @default(uuid())
  nama         String
  email        String @unique
  passwordHash String
  role         String @default("ADMIN") // ADMIN, PETUGAS, WARGA
  createdAt    DateTime @default(now())
}

model Anggota {
  id                String   @id @default(uuid())
  nama              String
  noRumah           String
  noHp              String?
  statusAktif       Boolean  @default(true)
  rombonganId       String?
  rombongan         Rombongan? @relation("RombonganAnggota", fields: [rombonganId], references: [id], onDelete: SetNull)
  memimpinRombongan Rombongan? @relation("RombonganKetua")
  createdAt         DateTime @default(now())
  
  jadwal            JadwalPetugas[]
  hutangPiutang     HutangPiutang[]
}

model Rombongan {
  id        String   @id @default(uuid())
  nama      String   @unique
  ketuaId   String?  @unique
  ketua     Anggota? @relation("RombonganKetua", fields: [ketuaId], references: [id], onDelete: SetNull)
  hariPiket Int?
  
  anggota   Anggota[] @relation("RombonganAnggota")
}

model JadwalPetugas {
  id         String    @id @default(uuid())
  anggotaId  String
  anggota    Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  tanggal    DateTime
  keterangan String?
  
  jimpitan   Jimpitan[]
}

model Jimpitan {
  id             String         @id @default(uuid())
  tanggal        DateTime
  jadwalId       String?
  jadwal         JadwalPetugas? @relation(fields: [jadwalId], references: [id], onDelete: SetNull)
  nominal        Int
  diisiOleh      String         // e.g. "Admin RT"
  diisiPada      DateTime       @default(now())
  catatan        String?
  
  // Offline sync fields
  localId        String?        @unique
  syncStatus     String?        @default("synced") // synced, pending, conflict
  createdAtLocal DateTime?
  syncedAt       DateTime?
}

model TransaksiKeuangan {
  id             String    @id @default(uuid())
  tanggal        DateTime
  jenis          String    // pemasukan, pengeluaran
  sumber         String    // jimpitan, lain-lain, manual
  kategori       String?
  keterangan     String
  nominal        Int
  buktiUrl       String?
  
  // Offline sync fields
  localId        String?   @unique
  syncStatus     String?   @default("synced") // synced, pending, conflict
  createdAtLocal DateTime?
  syncedAt       DateTime?

  pembayaranHutang PembayaranHutangPiutang?
}

model Agenda {
  id           String   @id @default(uuid())
  judul        String
  kategori     String   @default("umum") // kerjabakti, rapat, sosial, posyandu, umum
  tanggal      DateTime
  waktuMulai   String?  // e.g. "08:00"
  waktuSelesai String?  // e.g. "11:00"
  lokasi       String?  // e.g. "Balai RT 04"
  keterangan   String?
  status       String   @default("terjadwal") // terjadwal, selesai, dibatalkan
  createdAt    DateTime @default(now())
}

model Notifikasi {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PengaturanAplikasi {
  id             String   @id @default(uuid())
  namaApp        String   @default("komuna.id")
  namaRt         String   @default("RT 04")
  tagline        String   @default("Kebersamaan, Terpadu, Transparan")
  targetJimpitan Int      @default(3000000)
  updatedAt      DateTime @updatedAt
}

model HutangPiutang {
  id             String                    @id @default(uuid())
  tipe           String                    // "piutang" (hak RT) | "hutang" (kewajiban RT)
  judul          String                    // e.g. "Pinjaman Darurat Warga", "Material Gapura Toko Sejahtera"
  namaPihak      String                    // Nama orang / toko vendor
  kontakPihak    String?                   // No HP / WhatsApp untuk pengingat
  anggotaId      String?                   // Relasi opsional jika pihak adalah warga terdaftar
  anggota        Anggota?                  @relation(fields: [anggotaId], references: [id], onDelete: SetNull)
  
  totalNominal   Int                       // Total nilai pinjaman / tagihan
  sisaNominal    Int                       // Sisa nominal yang belum terbayar
  tanggalMulai   DateTime                  // Tanggal transaksi terjadi
  jatuhTempo     DateTime?                 // Tenggat waktu pelunasan (opsional)
  
  status         String                    @default("belum_lunas") // "belum_lunas" | "sebagian" | "lunas"
  kategori       String?                   // "sosial", "pembangunan", "kegiatan", "operasional", "lain-lain"
  catatan        String?
  diisiOleh      String                    // Nama admin yang mencatat
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  riwayatBayar   PembayaranHutangPiutang[]
}

model PembayaranHutangPiutang {
  id               String              @id @default(uuid())
  hutangPiutangId  String
  hutangPiutang    HutangPiutang       @relation(fields: [hutangPiutangId], references: [id], onDelete: Cascade)
  
  tanggalBayar     DateTime            @default(now())
  nominalBayar     Int                 // Jumlah cicilan yang dibayarkan
  sisaSebelumnya   Int                 // Sisa sebelum pembayaran ini
  sisaSetelahnya   Int                 // Sisa setelah pembayaran ini
  metode           String              @default("tunai") // "tunai" | "transfer"
  catatan          String?
  dicatatOleh      String
  
  // Integrasi ke Kas RT (Opsional terhubung ke TransaksiKeuangan)
  transaksiKasId   String?             @unique
  transaksiKas     TransaksiKeuangan?  @relation(fields: [transaksiKasId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
}
