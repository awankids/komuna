datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

model User {
  id           String @id @default(uuid())
  nama         String
  email        String @unique
  passwordHash String
  role         String @default("ADMIN") // ADMIN, PETUGAS, WARGA
  createdAt    DateTime @default(now())
}

model Anggota {
  id                String   @id @default(uuid())
  nama              String
  noRumah           String
  noHp              String?
  nik               String?
  noKk              String?
  tempatLahir       String?
  tanggalLahir      DateTime?
  jenisKelamin      String?   @default("Laki-laki")
  agama             String?   @default("Islam")
  pekerjaan         String?
  statusPerkawinan  String?   @default("Kawin")
  statusAktif       Boolean   @default(true)

  // Hierarki Keluarga
  statusKeluarga    String    @default("kepala_keluarga") // "kepala_keluarga" | "istri" | "anak" | "orang_tua" | "famili_lain"
  kepalaKeluargaId  String?
  kepalaKeluarga    Anggota?  @relation("KeluargaHierarchy", fields: [kepalaKeluargaId], references: [id], onDelete: SetNull)
  anggotaKeluarga   Anggota[] @relation("KeluargaHierarchy")

  // Kewajiban Operasional RT
  isWajibJimpitan   Boolean   @default(true)
  isWajibRonda      Boolean   @default(true)

  rombonganId       String?
  rombongan         Rombongan? @relation("RombonganAnggota", fields: [rombonganId], references: [id], onDelete: SetNull)
  memimpinRombongan Rombongan? @relation("RombonganKetua")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  
  jadwal            JadwalPetugas[]
  hutangPiutang     HutangPiutang[]
  pengurus          PengurusRT[]
  suratPengantar    SuratPengantar[]
  mutasi            MutasiWarga[]
}

model Rombongan {
  id        String   @id @default(uuid())
  nama      String   @unique
  ketuaId   String?  @unique
  ketua     Anggota? @relation("RombonganKetua", fields: [ketuaId], references: [id], onDelete: SetNull)
  hariPiket Int?
  
  anggota   Anggota[] @relation("RombonganAnggota")
}

model JadwalPetugas {
  id         String    @id @default(uuid())
  anggotaId  String
  anggota    Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  tanggal    DateTime
  keterangan String?
  
  jimpitan   Jimpitan[]
}

model Jimpitan {
  id             String         @id @default(uuid())
  tanggal        DateTime
  jadwalId       String?
  jadwal         JadwalPetugas? @relation(fields: [jadwalId], references: [id], onDelete: SetNull)
  nominal        Int
  diisiOleh      String         // e.g. "Admin RT"
  diisiPada      DateTime       @default(now())
  catatan        String?
  
  // Offline sync fields
  localId        String?        @unique
  syncStatus     String?        @default("synced") // synced, pending, conflict
  createdAtLocal DateTime?
  syncedAt       DateTime?
}

model TransaksiKeuangan {
  id             String    @id @default(uuid())
  tanggal        DateTime
  jenis          String    // pemasukan, pengeluaran
  sumber         String    // jimpitan, lain-lain, manual
  kategori       String?
  keterangan     String
  nominal        Int
  buktiUrl       String?
  
  // Offline sync fields
  localId        String?   @unique
  syncStatus     String?   @default("synced") // synced, pending, conflict
  createdAtLocal DateTime?
  syncedAt       DateTime?

  pembayaranHutang PembayaranHutangPiutang?
}

model Agenda {
  id           String   @id @default(uuid())
  judul        String
  kategori     String   @default("umum") // kerjabakti, rapat, sosial, posyandu, umum
  tanggal      DateTime
  waktuMulai   String?  // e.g. "08:00"
  waktuSelesai String?  // e.g. "11:00"
  lokasi       String?  // e.g. "Balai RT 04"
  keterangan   String?
  status       String   @default("terjadwal") // terjadwal, selesai, dibatalkan
  createdAt    DateTime @default(now())
}

model Notifikasi {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PengaturanAplikasi {
  id             String   @id @default(uuid())
  namaApp        String   @default("komuna.id")
  namaRt         String   @default("RT 04")
  tagline        String   @default("Kebersamaan, Terpadu, Transparan")
  targetJimpitan Int      @default(3000000)
  kotaWilayah    String   @default("Semarang")
  nomorSk        String?
  periodeAktif   String   @default("2024 - 2029")
  updatedAt      DateTime @updatedAt
}

model HutangPiutang {
  id             String                    @id @default(uuid())
  tipe           String                    // "piutang" (hak RT) | "hutang" (kewajiban RT)
  judul          String                    // e.g. "Pinjaman Darurat Warga", "Material Gapura Toko Sejahtera"
  namaPihak      String                    // Nama orang / toko vendor
  kontakPihak    String?                   // No HP / WhatsApp untuk pengingat
  anggotaId      String?                   // Relasi opsional jika pihak adalah warga terdaftar
  anggota        Anggota?                  @relation(fields: [anggotaId], references: [id], onDelete: SetNull)
  
  totalNominal   Int                       // Total nilai pinjaman / tagihan
  sisaNominal    Int                       // Sisa nominal yang belum terbayar
  tanggalMulai   DateTime                  // Tanggal transaksi terjadi
  jatuhTempo     DateTime?                 // Tenggat waktu pelunasan (opsional)
  
  status         String                    @default("belum_lunas") // "belum_lunas" | "sebagian" | "lunas"
  kategori       String?                   // "sosial", "pembangunan", "kegiatan", "operasional", "lain-lain"
  catatan        String?
  diisiOleh      String                    // Nama admin yang mencatat
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  riwayatBayar   PembayaranHutangPiutang[]
}

model PembayaranHutangPiutang {
  id               String              @id @default(uuid())
  hutangPiutangId  String
  hutangPiutang    HutangPiutang       @relation(fields: [hutangPiutangId], references: [id], onDelete: Cascade)
  
  tanggalBayar     DateTime            @default(now())
  nominalBayar     Int                 // Jumlah cicilan yang dibayarkan
  sisaSebelumnya   Int                 // Sisa sebelum pembayaran ini
  sisaSetelahnya   Int                 // Sisa setelah pembayaran ini
  metode           String              @default("tunai") // "tunai" | "transfer"
  catatan          String?
  dicatatOleh      String
  
  // Integrasi ke Kas RT (Opsional terhubung ke TransaksiKeuangan)
  transaksiKasId   String?             @unique
  transaksiKas     TransaksiKeuangan?  @relation(fields: [transaksiKasId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
}

model PengurusRT {
  id             String    @id @default(uuid())
  jabatan        String    // e.g. "Ketua RT", "Wakil Ketua RT", "Sekretaris", "Bendahara", "Seksi Keamanan"
  kategori       String    @default("inti") // "inti" | "seksi"
  nama           String
  nik            String?
  noHp           String?
  alamatRumah    String?
  
  anggotaId      String?
  anggota        Anggota?  @relation(fields: [anggotaId], references: [id], onDelete: SetNull)
  
  urutan         Int       @default(1)
  periode        String?   @default("2024 - 2029")
  statusAktif    Boolean   @default(true)
  keterangan     String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SuratPengantar {
  id                   String    @id @default(uuid())
  nomorSurat           String    @unique
  nomorUrut            Int
  jenisSurat           String    // "ktp_kk", "skck", "domisili", "sku", "belum_nikah", "kematian", "keramaian", "kustom"
  judulSurat           String
  
  anggotaId            String?
  anggota              Anggota?  @relation(fields: [anggotaId], references: [id], onDelete: SetNull)
  
  namaWarga            String
  nik                  String?
  tempatLahir          String?
  tanggalLahir         DateTime?
  jenisKelamin         String?
  agama                String?
  pekerjaan            String?
  statusPerkawinan     String?
  alamat               String
  
  keperluan            String
  keteranganTambahan   String?
  
  tanggalSurat         DateTime  @default(now())
  berlakuHingga        DateTime?
  namaPenandatangan    String
  jabatanPenandatangan String
  kotaSurat            String    @default("Semarang")
  
  kodeVerifikasi       String    @unique @default(cuid())
  status               String    @default("aktif") // "aktif" | "dibatalkan"
  dibuatOleh           String    @default("Admin RT")
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// 1. Pencatatan Dinamika Kependudukan (Mutasi Warga)
model MutasiWarga {
  id               String    @id @default(uuid())
  jenisMutasi      String    // "lahir" | "meninggal" | "masuk" | "keluar"
  tanggalPeristiwa DateTime  @default(now())
  
  namaWarga        String
  nik              String?
  noRumah          String?
  jenisKelamin     String?   // "Laki-laki" | "Perempuan"
  keterangan       String?   // Asal/tujuan pindah, penyebab, no surat pengantar
  
  anggotaId        String?
  anggota          Anggota?  @relation(fields: [anggotaId], references: [id], onDelete: SetNull)
  
  dicatatOleh      String    @default("Sekretaris RT")
  createdAt        DateTime  @default(now())
}

// 2. Program Kerja & Capaian Tahunan
model ProgramKerja {
  id                String    @id @default(uuid())
  tahun             Int       // e.g. 2026
  bidang            String    // "lingkungan", "keamanan", "sosial_pkk", "pembangunan", "keagamaan", "kepemudaan"
  namaProgram       String    // e.g. "Kerja Bakti Massal Normalisasi Saluran Air"
  targetBulan       String?   // e.g. "Maret 2026", "Triwulan II"
  
  anggaranRencana   Int       @default(0)
  anggaranRealisasi  Int       @default(0)
  
  status            String    @default("terlaksana") // "terlaksana", "berjalan", "tertunda", "batal"
  persentase        Int       @default(100) // 0 - 100%
  keteranganHasil   String?   // Deskripsi hasil kegiatan & manfaat
  dokumentasiUrl    String?   // Lampiran foto kegiatan (opsional)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 3. Buku Inventaris & Aset Lingkungan RT
model InventarisAset {
  id               String          @id @default(uuid())
  kodeBarang       String?         // e.g. "AST-001", "TND-01"
  namaBarang       String          // e.g. "Tenda Terop Besi 4 x 6 meter"
  kategori         String          // "tenda_kursi", "kebersihan", "elektronik_sound", "keamanan", "peralatan"
  jumlah           Int             @default(1)
  satuan           String          @default("unit") // unit, buah, set, rol
  
  kondisiBaik      Int             @default(1)
  kondisiRusak     Int             @default(0)
  
  lokasiSimpan     String?         @default("Balai RT")
  tahunPengadaan   Int             @default(2025)
  sumberPerolehan  String          @default("Kas RT") // "Kas RT", "Swadaya Warga", "Hibah Kelurahan"
  statusTahunIni   String          @default("tetap") // "tetap", "bertambah_baru", "perbaikan", "afkir"
  
  keterangan       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  peminjaman       PeminjamanAset[]
}

// Sub-model: Catatan Peminjaman Aset oleh Warga
model PeminjamanAset {
  id               String         @id @default(uuid())
  inventarisId     String
  inventaris       InventarisAset @relation(fields: [inventarisId], references: [id], onDelete: Cascade)
  
  namaPeminjam     String
  noRumah          String?
  kontakPeminjam   String?
  jumlahPinjam     Int            @default(1)
  keperluan        String         // Hajatan, tasyakuran, kematian
  
  tanggalPinjam    DateTime       @default(now())
  tanggalKembali   DateTime?
  status           String         @default("dipinjam") // "dipinjam" | "dikembalikan"
  catatanKondisi   String?
  
  createdAt        DateTime       @default(now())
}

// 4. Refleksi Tahunan: Kendala, Solusi, & Rencana Masa Depan
model EvaluasiTahunan {
  id               String    @id @default(uuid())
  tahun            Int       @unique // e.g. 2026
  
  kataPengantar    String?   // Pesan pembuka dari Ketua RT
  kendalaTantangan String    // Hambatan operasional selama setahun
  solusiTindakan   String    // Solusi dan rekomendasi yang diterapkan
  usulanRencana    String    // Rencana kerja prioritas tahun berikutnya
  estimasiAnggaran Int       @default(0)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}


